# =============================================================================
# Corpo Ativo — API (apps/api)
# Copie este arquivo para `.env` e preencha os valores.
# =============================================================================

# --- Banco de dados (Postgres / Supabase) ---
# Usado pelo Prisma para queries (pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Conexão direta — necessária para migrations (`prisma migrate`)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- Servidor ---
PORT=3333
NODE_ENV=development

# --- Autenticação (JWT) ---
# Obrigatório em produção. Gere com: openssl rand -base64 32
JWT_SECRET="troque-por-um-segredo-forte"

# --- Seed do admin (opcional — apenas desenvolvimento) ---
ADMIN_CPF="00000000000"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrador"

# --- Asaas (pagamentos) ---
# Sandbox: https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/v3
ASAAS_API_KEY=""
ASAAS_BASE_URL="https://sandbox.asaas.com/api/v3"
ASAAS_WEBHOOK_TOKEN=""
